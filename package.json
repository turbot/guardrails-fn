{
  "name": "@turbot/guardrails-fn",
  "author": "Turbot HQ, Inc",
  "version": "5.1.1",
  "description": "Guardrails Fn.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/turbot/guardrails-fn.git"
  },
  "main": "index.js",
  "scripts": {
    "coverage": "npx nyc npm test",
    "test": "npx mocha"
  },
  "dependencies": {
    "@turbot/guardrails-aws-sdk-v3": "5.1.0",
    "@aws-sdk/client-sns": "3.1012.0",
    "@aws-sdk/client-kms": "3.1012.0",
    "@turbot/errors": "5.3.0",
    "@turbot/log": "5.5.0",
    "@turbot/sdk": "5.16.0",
    "@turbot/utils": "5.6.0",
    "@turbot/sns-validator": "5.0.3",
    "archiver": "5.3.1",
    "async": "3.2.4",
    "extract-zip": "2.0.1",
    "fs-extra": "11.3.4",
    "got": "11.8.6",
    "lodash": "4.17.23",
    "rimraf": "3.0.2",
    "stream-buffers": "3.0.2",
    "tmp": "0.2.5",
    "url": "0.11.1"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "prettier": "3.3.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:prettier/recommended",
      "eslint:recommended",
      "plugin:you-dont-need-lodash-underscore/compatible"
    ],
    "env": {
      "es6": true,
      "node": true,
      "mocha": true
    },
    "parserOptions": {
      "ecmaVersion": 10
    },
    "rules": {
      "no-console": "off",
      "you-dont-need-lodash-underscore/is-nil": "off",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "overrides": {
    "fast-xml-parser": "5.5.7"
  },
  "prettier": {
    "printWidth": 120
  }
}
