# No package runs its own install scripts (preinstall, install, postinstall) when we install.
# A hijacked release of any dependency would otherwise run code on the machine that installs it,
# a developer's, CI's or an unattended Agent Fleet worker's holding a GitHub token.
# No package in package-lock.json has hasInstallScript, so nothing needs one; test/npmrc.js
# fails if one ever does. npm test and npx mocha still run: ignore-scripts only skips the
# lifecycle scripts of an install, not a script run by name.
ignore-scripts=true
